export type SavingsAccount={id:string;account_type:"checking"|"savings"};
export type SavingsCategory={id:string;parent_id:string|null;monthly_budget:number;account_id?:string|null};
export type SavingsMovement={id?:string;account_id:string;category_id:string|null;movement_type:string;amount:number;movement_date:string;status:string;recurrence_id?:string|null};
export type SavingsRecurrence={id:string;account_id:string;destination_account_id:string|null;category_id:string|null;movement_type:"income"|"expense"|"transfer";amount:number;frequency:string;interval_count:number;start_date:string;end_date:string|null;is_active?:boolean};
export type SavingsOverride={recurrence_id:string;occurrence_month:string;amount:number};
export type SavingsExclusion={recurrence_id:string;occurrence_date:string};
export type SavingsPhotoPayment={amount:number;expected_date:string|null;received_date:string|null;status:string;personal_account_id:string|null;accounting_status?:string};
export type SavingsUrssafState={contribution_month:string;account_id:string|null;is_completed:boolean};
export type SavingsPlanRow={month:string;checking:number;savings:number;proposal:number;income:number;expense:number;requiredReserve:number};

type Input={
 sourceAccountId:string;
 destinationAccountId:string;
 initialChecking:number;
 initialSavings:number;
 startMonth:string;
 categories:SavingsCategory[];
 movements:SavingsMovement[];
 recurrences:SavingsRecurrence[];
 overrides?:SavingsOverride[];
 exclusions?:SavingsExclusion[];
 photoPayments?:SavingsPhotoPayment[];
 urssafStates?:SavingsUrssafState[];
 urssafDefaultAccountId?:string|null;
 months?:number;
};

const shift=(month:string,delta:number)=>{const d=new Date(`${month}-01T12:00:00`);d.setMonth(d.getMonth()+delta);return d.toISOString().slice(0,7)};
const iso=(d:Date)=>d.toISOString().slice(0,10);
const add=(date:Date,frequency:string,count:number)=>{const d=new Date(date);if(frequency==="weekly")d.setDate(d.getDate()+7*count);else if(frequency==="quarterly")d.setMonth(d.getMonth()+3*count);else if(frequency==="yearly")d.setFullYear(d.getFullYear()+count);else d.setMonth(d.getMonth()+count);return d};

export function calculateSavingsPlan(input:Input):SavingsPlanRow[]{
 const count=input.months??60;
 const categoryById=new Map(input.categories.map(c=>[c.id,c]));
 const root=(id:string|null)=>{let c=id?categoryById.get(id):undefined;while(c?.parent_id)c=categoryById.get(c.parent_id);return c?.id??null};
 const roots=input.categories.filter(c=>!c.parent_id&&Number(c.monthly_budget)>0&&c.account_id===input.sourceAccountId);
 const overrideMap=new Map((input.overrides??[]).map(o=>[`${o.recurrence_id}:${String(o.occurrence_month).slice(0,7)}`,Number(o.amount)]));
 const exclusionSet=new Set((input.exclusions??[]).map(e=>`${e.recurrence_id}:${e.occurrence_date}`));
 const materialized=new Set(input.movements.filter(m=>m.recurrence_id).map(m=>`${m.recurrence_id}:${m.movement_date}`));
 const photoForMonth=(month:string)=>(input.photoPayments??[]).filter(p=>p.status==="expected"&&(p.expected_date??"").startsWith(month)&&p.personal_account_id===input.sourceAccountId).reduce((s,p)=>s+Number(p.amount),0);
 const photoCaForMonth=(month:string)=>(input.photoPayments??[]).filter(p=>(p.accounting_status??p.status)!=="cancelled"&&((p.accounting_status??p.status)==="received"?(p.received_date??p.expected_date):p.expected_date)?.startsWith(month)).reduce((s,p)=>s+Number(p.amount),0);
 const urssafStateMap=new Map((input.urssafStates??[]).map(s=>[String(s.contribution_month).slice(0,7),s]));
 const flows:{month:string;income:number;expense:number;net:number}[]=[];
 for(let i=0;i<count;i++){
  const month=shift(input.startMonth,i);let income=0,expense=0;const spent=new Map<string,number>();
  for(const m of input.movements.filter(x=>x.movement_date.startsWith(month))){
   if(m.account_id!==input.sourceAccountId)continue;
   const amount=Number(m.amount);
   if(m.status==="planned"){const positive=["income","transfer_in"].includes(m.movement_type);if(positive)income+=amount;else expense+=amount;}
   if(m.movement_type==="expense"){const r=root(m.category_id);if(r)spent.set(r,(spent.get(r)??0)+amount)}
  }
  for(const r of input.recurrences.filter(r=>r.is_active!==false)){
   let d=new Date(`${r.start_date}T12:00:00`),guard=0;const end=new Date(`${month}-01T12:00:00`);end.setMonth(end.getMonth()+1);end.setDate(0);
   while(d<=end&&guard++<3000){const date=iso(d);if(date.startsWith(month)&&(!r.end_date||date<=r.end_date)&&!exclusionSet.has(`${r.id}:${date}`)&&!materialized.has(`${r.id}:${date}`)){
    const amount=overrideMap.get(`${r.id}:${month}`)??Number(r.amount);
    if(r.movement_type==="income"&&r.account_id===input.sourceAccountId)income+=amount;
    else if(r.movement_type==="expense"&&r.account_id===input.sourceAccountId){expense+=amount;const rt=root(r.category_id);if(rt)spent.set(rt,(spent.get(rt)??0)+amount)}
    else if(r.movement_type==="transfer"){if(r.account_id===input.sourceAccountId)expense+=amount;if(r.destination_account_id===input.sourceAccountId)income+=amount}
   }
    d=add(d,r.frequency,Math.max(1,Number(r.interval_count||1)));
   }
  }
  income+=photoForMonth(month);
  const urssaf=Math.round(photoCaForMonth(shift(month,-1))*0.216*100)/100;const us=urssafStateMap.get(month);const urssafAccount=us?.account_id??input.urssafDefaultAccountId;
  if(urssaf>0&&!us?.is_completed&&urssafAccount===input.sourceAccountId)expense+=urssaf;
  for(const b of roots){expense+=Math.max(0,Number(b.monthly_budget)-(spent.get(b.id)??0))}
  flows.push({month,income,expense,net:income-expense});
 }
 const reserves=new Array<number>(count).fill(500);let cumulative=0,minFuture=0;
 for(let i=count-1;i>=0;i--){reserves[i]=500+Math.max(0,-minFuture);cumulative=flows[i].net+cumulative;minFuture=Math.min(0,cumulative)}
 let checking=Number(input.initialChecking),savings=Number(input.initialSavings);const rows:SavingsPlanRow[]=[];
 for(let i=0;i<count;i++){const f=flows[i];checking+=f.net;const proposal=Math.max(0,checking-reserves[i]);if(proposal>0){checking-=proposal;savings+=proposal}rows.push({month:f.month,checking,savings,proposal,income:f.income,expense:f.expense,requiredReserve:reserves[i]})}
 return rows;
}
